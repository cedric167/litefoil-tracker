{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('pseudo').val() === root.child('profiles/'+$uid+'/pseudo').val() && root.child('profiles/'+$uid+'/nk').exists()"
      }
    },
    "typing": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "newData.child('pseudo').val() === root.child('profiles/'+$uid+'/pseudo').val()"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "newData.child('pseudo').isString() && newData.child('pseudo').val().length <= 24 && newData.child('nk').isString() && newData.child('nk').val().matches(/^[a-z0-9]{2,24}$/) && newData.child('nk').val() === newData.child('pseudo').val().toLowerCase().replace('à','a').replace('â','a').replace('ä','a').replace('é','e').replace('è','e').replace('ê','e').replace('ë','e').replace('î','i').replace('ï','i').replace('ô','o').replace('ö','o').replace('ù','u').replace('û','u').replace('ü','u').replace('ç','c').replace('ÿ','y').replace('œ','oe').replace('æ','ae').replace(' ','').replace('.','').replace('-','').replace('_','').replace(\"'\",'') && newData.parent().parent().child('names').child(newData.child('nk').val()).val() === $uid"
      }
    },
    "pushTokens": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ( (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && !newData.exists()) )",
        "reactions": {
          "$ruid": {
            ".write": "auth != null && auth.uid === $ruid && auth.token.email_verified === true"
          }
        },
        ".validate": "(data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val()))"
      }
    },
    "dm": {
      "$pair": {
        ".read": "auth != null && $pair.contains(auth.uid)",
        ".write": "auth != null && $pair.contains(auth.uid)",
        "$mid": {
          ".validate": "(data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val()))"
        }
      }
    },
    "reports": {
      ".read": false,
      "$id": {
        ".write": "auth != null"
      }
    },
    "groups": {
      "$gid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.child('members').child(auth.uid).exists())",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.token.email_verified === true && ($uid === auth.uid || data.parent().parent().child('members').child(auth.uid).exists())"
          }
        }
      }
    },
    "userGroups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true"
      }
    },
    "groupMessages": {
      "$gid": {
        ".read": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('groups').child($gid).child('members').child(auth.uid).exists()",
        "$mid": {
          ".validate": "(data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val()))"
        }
      }
    },
    "userDM": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true"
      }
    },
    "events": {
      ".read": "auth != null",
      ".indexOn": [
        "when"
      ],
      "$eid": {
        ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid) || (data.exists() && data.child('by').val() === auth.uid))",
        ".validate": "newData.hasChildren(['title','when','by']) && newData.child('title').isString() && newData.child('title').val().length <= 60 && newData.child('when').isNumber() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 300000)) && (data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('byPseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val()))",
        "att": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true"
          }
        }
      }
    },
    "eventMessages": {
      "$eid": {
        ".read": "auth != null && (root.child('events/'+$eid+'/att/'+auth.uid).exists() || root.child('events/'+$eid+'/by').val() === auth.uid)",
        "$id": {
          ".write": "auth != null && (root.child('events/'+$eid+'/att/'+auth.uid).exists() || root.child('events/'+$eid+'/by').val() === auth.uid) && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "!newData.exists() || ((data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val())) && newData.child('text').isString() && newData.child('text').val().length <= 400)",
          "reactions": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true"
            }
          }
        }
      }
    },
    "unread": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "official": {
      ".read": "auth != null",
      ".write": false
    },
    "stats": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('n').isNumber() && newData.child('km').isNumber() && newData.child('n').val() <= 5000 && newData.child('km').val() <= 200000 && (!newData.child('eKm').exists() || (newData.child('eKm').isNumber() && newData.child('eKm').val() <= 5000)) && (!newData.child('wKm').exists() || (newData.child('wKm').isNumber() && newData.child('wKm').val() <= 2000))"
      }
    },
    "welcomed": {
      ".read": false,
      ".write": false
    },
    "cards": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.child('img').isString() && newData.child('img').val().length <= 400000)"
      }
    },
    "videos": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$vid": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('official/'+auth.uid).exists())))",
        ".validate": "!newData.exists() || (newData.child('url').isString() && newData.child('caption').val().length <= 150 && (data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val())))",
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true"
          }
        }
      }
    },
    "videoComments": {
      "$vid": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && root.child('official/'+auth.uid).exists()",
        "$cid": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('official/'+auth.uid).exists())))",
          ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 300 && (data.exists() || (auth.token.email_verified === true && root.child('profiles/'+auth.uid+'/nk').exists() && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val())))"
        }
      }
    },
    "names": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null && auth.token.email_verified === true && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))",
        ".validate": "$k.matches(/^[a-z0-9]{2,24}$/) && (root.child('official/'+auth.uid).exists() || (!$k.contains('litefoil') && !$k.contains('cedricmorer') && !$k.contains('charlymost') && $k !== 'admin' && $k !== 'moderateur' && $k !== 'moderation' && $k !== 'support'))"
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.token.email_verified === true && ((auth.uid === $from && $from !== $to && (!newData.exists() || root.child('profiles/'+$to+'/nk').exists())) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val()"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null",
        "$o": {
          ".write": "auth != null && auth.token.email_verified === true && ((!newData.exists() && (auth.uid === $uid || auth.uid === $o)) || (auth.uid === $uid && root.child('friendReq/'+$uid+'/'+$o).exists()) || (auth.uid === $o && root.child('friendReq/'+$o+'/'+$uid).exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('friends/'+$uid+'/'+auth.uid).exists())",
        "$sid": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
          ".validate": "newData.hasChildren(['t','d']) && newData.child('t').isNumber() && newData.child('d').isNumber() && (!newData.child('shape').exists() || (newData.child('shape').isString() && newData.child('shape').val().length <= 1200))"
        }
      }
    },
    "ratings": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "!newData.exists() || (newData.child('g').isNumber() && newData.child('g').val() >= 1 && newData.child('g').val() <= 99)",
        "d": {
          "$k": {
            ".validate": "newData.child('r').isNumber() && newData.child('r').val() >= 1 && newData.child('r').val() <= 99 && $k.matches(/^[a-z]{2,16}$/)"
          }
        }
      }
    },
    "results": {
      ".read": "auth != null",
      "$uid": {
        "$id": {
          ".write": "auth != null && ((auth.uid === $uid && auth.token.email_verified === true && (!newData.exists() || newData.child('st').val() === 'pending')) || root.child('official/'+auth.uid).exists())",
          ".validate": "!newData.exists() || (newData.child('comp').isString() && newData.child('comp').val().length >= 3 && newData.child('comp').val().length <= 80 && newData.child('date').isNumber() && newData.child('sport').isString() && newData.child('sport').val().length <= 16 && (!newData.child('perf').exists() || newData.child('perf').val().length <= 30) && (!newData.child('fed').exists() || newData.child('fed').val().length <= 40) && (!newData.child('proof').exists() || (newData.child('proof').isString() && newData.child('proof').val().beginsWith('https://') && newData.child('proof').val().length <= 300)) && (newData.child('st').val() === 'pending' || newData.child('st').val() === 'ok' || newData.child('st').val() === 'no'))"
        }
      }
    },
    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "!newData.exists() || newData.hasChildren(['t'])"
      }
    },
    "profileViews": {
      "$owner": {
        ".read": "auth != null && auth.uid === $owner",
        ".write": "auth != null && auth.uid === $owner && !newData.exists()",
        "$viewer": {
          ".write": "auth != null && auth.token.email_verified === true && ((auth.uid === $viewer && $viewer !== $owner && root.child('profiles/'+$owner+'/nk').exists()) || (auth.uid === $owner && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['t','pseudo']) && newData.child('t').val() === now && newData.child('pseudo').val() === root.child('profiles/'+auth.uid+'/pseudo').val())"
        }
      }
    }
  }
}
