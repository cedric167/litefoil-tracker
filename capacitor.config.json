{
  "appId": "fr.litefoil.tracker",
  "appName": "Lite Foil",
  "webDir": "www",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0f1419"
  },
  "android": {
    "backgroundColor": "#0f1419"
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Recherche d'appareils…",
        "cancel": "Annuler",
        "availableDevices": "Appareils Lite Foil",
        "noDeviceFound": "Aucun appareil trouvé"
      }
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "apple.com",
        "google.com"
      ]
    }
  },
  "server": {
    "url": "https://cedric167.github.io/litefoil-tracker/",
    "cleartext": false
  },
  "appendUserAgent": " LiteFoilCall/1 LiteFoilRing/1"
}
